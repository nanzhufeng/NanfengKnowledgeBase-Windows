{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "南枫情报台",
  "version": "0.1.0",
  "identifier": "com.nanzhufeng.nanfengintelligence",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:4173",
    "beforeDevCommand": "npm run dev -- --port 4173 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "南枫情报台",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
